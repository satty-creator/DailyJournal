{
  "name": "spilr-rules-tests",
  "private": true,
  "description": "Firestore security-rules tests. Run against the Firestore emulator: npm test (from this folder).",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-spilr-rules \"node --test\"",
    "test:ci": "node --test"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.29.0"
  }
}
