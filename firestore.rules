rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // AI entitlement + usage budget (ai-cost-audit-2026-09-06.md Phase 4/5).
    // Written only by geminiProxy (usage counters) and the RevenueCat webhook
    // (entitlement), both via the Admin SDK.
    //
    // TOP-LEVEL and deny-all deliberately, NOT a field on the user doc: the
    // `users/{userId}` rule below grants the owner full read/write over their
    // own doc and everything beneath it, so an `entitlement` field living
    // there would be client-writable — any signed-in user could set
    // themselves to "paid". Keeping this collection outside that recursive
    // rule is what makes it a real enforcement boundary instead of a
    // client-side suggestion.
    match /aiUsage/{uid} {
      allow read, write: if false;
    }
    match /entitlements/{uid} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // True when a write changes ONLY the named fields. Used to let the client
    // record its own feedback on a server-owned document without being able to
    // rewrite the document's substance.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ── Per-user data ────────────────────────────────────────────────────
    //
    // READ stays recursive; WRITE does not.
    //
    // WHY READ IS STILL A WILDCARD: the app stores a growing set of per-user
    // subcollections, and whitelisting them one by one meant any NEW
    // subcollection was silently DENIED — which is exactly what starved the AI
    // of context once already (selfModel / patternHypotheses / entryAnalyses
    // all failing with "Missing or insufficient permissions"). A single
    // owner-scoped recursive read prevents that class of bug from recurring,
    // and reading your own data is never the risk here.
    //
    // WHY WRITE IS NOT: `patternHypotheses`, `selfModel`, `mirrorCards`,
    // `derived`, `observations` and `readings` are written by the Admin SDK
    // and are meant to be server truth. Under a recursive write rule any
    // client could forge a hypothesis, rewrite an observation's counts, or
    // delete the Self Model — and "evidence-backed, correctable" is the
    // product's actual promise, so a model the client can silently rewrite is
    // not evidence-backed (engineering-decisions-ai-architecture §5.3).
    //
    // CRITICAL, AND EASY TO GET WRONG: Firestore rules are OR'd, not
    // first-match. A narrow `allow write` further down CANNOT restrict a
    // broader one above it — the broad rule still grants. That is why the
    // recursive block below grants READ ONLY, and every write is enumerated.
    // Cloud Functions use the Admin SDK and bypass all of this.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);

      match /{document=**} {
        allow read: if isOwner(userId);
      }

      // ── Client-owned: the user's own material ──────────────────────────
      match /entries/{docId}             { allow write: if isOwner(userId); }
      match /entryAnalyses/{docId}       { allow write: if isOwner(userId); }
      match /events/{docId}              { allow write: if isOwner(userId); }
      match /profileCorrections/{docId}  { allow write: if isOwner(userId); }
      // The audit trail for Daily Chat's write-back into the model (see
      // AIService+Chat.extractModelOps + SelfModelService.recordModelOp) —
      // client-owned like profileCorrections, since it's the user's own
      // record of what a conversation changed and each row is undoable.
      match /modelOps/{docId}            { allow write: if isOwner(userId); }
      match /lifeContext/{docId}         { allow write: if isOwner(userId); }
      match /stylePreferences/{docId}    { allow write: if isOwner(userId); }
      match /mirrorShown/{docId}         { allow write: if isOwner(userId); }
      match /moodLogs/{docId}            { allow write: if isOwner(userId); }
      match /echoes/{docId}              { allow write: if isOwner(userId); }
      match /pushTokens/{docId}          { allow write: if isOwner(userId); }
      match /rollups/{docId}             { allow write: if isOwner(userId); }
      match /chatSessions/{docId}        { allow write: if isOwner(userId); }
      // Retired collections. Still writable so an older client build cannot
      // start failing mid-session, and still readable/deletable so account
      // deletion keeps erasing them.
      match /riverMarks/{docId}          { allow write: if isOwner(userId); }
      match /mirrors/{docId}             { allow write: if isOwner(userId); }
      match /dailyReads/{docId}          { allow write: if isOwner(userId); }

      // ── Server-owned: feedback-only writes ─────────────────────────────
      //
      // Purely derived. Nothing the client could say about these is
      // information the server does not already have, and a forged count here
      // would corrupt every downstream comparison.
      match /derived/{docId} {
        allow write: if false;
      }

      // The client records that it SHOWED an observation and what the user
      // said about it — never the arithmetic.
      match /observations/{docId} {
        allow update: if isOwner(userId)
                      && onlyChanges(['userStatus', 'shownAt', 'notQuiteCount']);
        allow create, delete: if false;
      }

      match /readings/{docId} {
        allow update: if isOwner(userId)
                      && onlyChanges(['userStatus', 'shownAt', 'followUp']);
        allow create, delete: if false;
      }

      // `userStatus` is the confirmation ("This is me"); `status` is the
      // forget affordance (closed / muted / dismissed). Both are the user's to
      // set; evidence, counts, lifecycle and the audit verdict are not.
      match /patternHypotheses/{docId} {
        allow update: if isOwner(userId)
                      && onlyChanges(['userStatus', 'status', 'shownAt',
                                      'respondedAt', 'closedAt', 'salienceScore',
                                      'stability', 'lifecycle', 'lastEvidenceAt']);
        allow create, delete: if false;
      }

      match /mirrorCards/{docId} {
        allow update: if isOwner(userId) && onlyChanges(['userFeedback']);
        allow create, delete: if false;
      }

      // The Person Model (mirror-v3.1-person-model-2026-09-10.md §4) —
      // patternHypotheses' successor. Same shape of promise: "This is me" /
      // "Not quite" (and its Wrong/Half/Too much follow-up) are the user's
      // to set; evidence, confidence, and the disconfirmation verdict are
      // server truth, assembled by Prompt F and the gate in gate.js.
      match /personModel/{docId} {
        allow update: if isOwner(userId)
                      && onlyChanges(['userStatus', 'shownAt', 'notQuiteCount', 'respondedAt']);
        allow create, delete: if false;
      }

      match /mirrorLetters/{docId} {
        allow update: if isOwner(userId) && onlyChanges(['openedAt']);
        allow create, delete: if false;
      }

      // The Self Model is assembled server-side, but the client still has a
      // deterministic local fallback for a user the nightly job has not
      // reached (SelfModelService.assembleFromHypotheses), which refuses to
      // overwrite a server-written model. Keep it writable, and keep it
      // deletable — "delete everything Spilr thinks it knows" is a promise in
      // the privacy PRD.
      match /selfModel/{docId} {
        allow write: if isOwner(userId);
      }
    }
  }
}
